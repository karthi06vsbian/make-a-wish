# ====================================================================
# MAKE A WISH • Environment Configuration Template
# All secret keys belong strictly on the server / Supabase Edge Functions.
# Never expose secrets in client-side code.
# ====================================================================

# Frontend Public Variables (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here
VITE_APP_URL=https://make-a-wish.vercel.app

# Server / Supabase Edge Function Secrets (Set in Supabase Dashboard -> Secrets)
# DO NOT include these in client .env
# RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
